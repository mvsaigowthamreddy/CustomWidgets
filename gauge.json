{
  "eula": "",
  "vendor": "YourCompany",
  "license": "",
  "id": "com-yourcompany-gauge-1",
  "icon": "https://raw.githubusercontent.com/mvsaigowthamreddy/CustomWidgets/main/donut_gauge.png",
  "version": "1.0.0",
  "name": "Donut Gauge (Simple)",
  "newInstancePrefix": "DonutGauge",
  "description": "Simple animated donut gauge - shows value/target as percentage",

  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-yourcompany-gauge",
      "url": "https://raw.githubusercontent.com/mvsaigowthamreddy/CustomWidgets/main/gauge.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],

  "properties": {
    "value": {
      "type": "number",
      "default": 65,
      "description": "Main percentage value"
    },
    "target": {
      "type": "number",
      "default": 100,
      "description": "Target value used for % calculation"
    },
    "title": {
      "type": "string",
      "default": "Sales %",
      "description": "Title displayed on gauge"
    }
  },

  "methods": {
    "setValue": {
      "parameters": [
        { "name": "value", "type": "number" }
      ],
      "body": "this.value = value;"
    },
    "setTarget": {
      "parameters": [
        { "name": "target", "type": "number" }
      ],
      "body": "this.target = target;"
    },
    "setTitle": {
      "parameters": [
        { "name": "title", "type": "string" }
      ],
      "body": "this.title = title;"
    }
  },

  "events": {
    "onValueChanged": {
      "description": "Triggered when value changes"
    }
  }
}
