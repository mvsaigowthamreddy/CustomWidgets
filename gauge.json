{
  "id": "com-yourcompany-gauge-1",
  "version": "1.0.0",
  "name": "Donut Gauge (Simple)",
  "description": "Simple animated donut gauge - shows value/target as percentage",
  "author": "You",
  "resources": [
    { "type": "webcomponent", "uri": "https://raw.githubusercontent.com/mvsaigowthamreddy/CustomWidgets/refs/heads/main/gauge.js" }
  ],
  "icon": "https://raw.githubusercontent.com/mvsaigowthamreddy/CustomWidgets/main/donut_gauge.png",
  "tags": ["KPI", "Gauge", "Donut"],
  "properties": [
    {
      "name": "value",
      "type": "number",
      "defaultValue": 65,
      "displayName": "Value (%)",
      "description": "Main percentage value"
    },
    {
      "name": "target",
      "type": "number",
      "defaultValue": 100,
      "displayName": "Target",
      "description": "Target (used to compute percent)"
    },
    {
      "name": "title",
      "type": "string",
      "defaultValue": "Sales %",
      "displayName": "Title"
    }
  ]
}
